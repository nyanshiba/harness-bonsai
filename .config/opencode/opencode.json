{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "plugins": [
    "/root/.config/opencode/plugins/personality",
    "/root/.config/opencode/plugins/tool-hints",
    "/root/.config/opencode/plugins/ask-once",
    "/root/.config/opencode/plugins/delegate-guard",
    "/root/.config/opencode/plugins/service-guard",
    "/root/.config/opencode/plugins/session-move",
    "/root/.config/opencode/plugins/writing-hints",
    "@prevalentware/opencode-loop-plugin@0.1.8",
    "/root/.config/opencode/plugins/handoff",
    {
      "package": "/root/.config/opencode/plugins/rate-limit-command",
      "options": {
        "command": {
          "executable": "/usr/bin/networkctl",
          "args": ["reconfigure", "eth0"]
        }
      }
    }
  ],
  "websearch": {
    "provider": "parallel"
  },
  "default_agent": "plan",
  "experimental": {
    "subagent_depth": 1
  },
  "agents": {
    "plan": {
      "permissions": [
        { "action": "edit", "resource": "~/.opencode/plan/*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "linkding_*", "resource": "*", "effect": "allow" }
      ]
    },
    "build": {
      "mode": "all",
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "subagent", "resource": "build", "effect": "allow" },
        { "action": "external_directory", "resource": "*", "effect": "ask" },
        { "action": "external_directory", "resource": "~/.opencode/plan/**", "effect": "allow" },
        { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" }
      ]
    },
    "build-auto": {
      "mode": "all",
      "permissions": [
        { "action": "external_directory", "resource": "*", "effect": "ask" },
        { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
        { "action": "read", "resource": "*.env", "effect": "allow" },
        { "action": "read", "resource": "*.env.*", "effect": "allow" },
        { "action": "subagent", "resource": "build-auto", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" }
      ]
    },
    "general": { "disabled": true },
    "explorer": { "disabled": true },
    "websearch-researcher": {
      "permissions": [
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" }
      ]
    },
    "linkding-researcher": {
      "permissions": [
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "linkding_*", "resource": "*", "effect": "allow" }
      ]
    },
    "feed-triage": {
      "permissions": [
        { "action": "edit", "resource": "feed/replies/*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" }
      ]
    },
    "opencode-musespark-1.3": {
      "mode": "primary",
      "model": "opencode/muse-spark-1.3-contributor-free#high"
    },
    "opencode-musespark-1.2": {
      "mode": "primary",
      "model": "opencode/muse-spark-1.2-contributor-free#high"
    },
    "openrouter-minimax-m3": {
      "mode": "primary",
      "model": "openrouter/minimax/minimax-m3:free#thinking"
    },
    "opencode-nemotron-3.5-lightning-free": {
      "mode": "primary",
      "model": "opencode/nemotron-3.5-lightning-free"
    },
    "opencode-mimo-v2.6-flash-free": {
      "mode": "primary",
      "model": "opencode/mimo-v2.6-flash-free"
    },
    "opencode-space-bunny-free": {
      "mode": "primary",
      "model": "opencode/space-bunny-free"
    },
    "openrouter-dots-3-note-preview": {
      "mode": "primary",
      "model": "openrouter/dots-studio/dots-3-note-preview:free#thinking"
    },
    "google-gemma-4-26b-a4b-it": {
      "mode": "primary",
      "model": "google/gemma-4-26b-a4b-it"
    },
    "google-gemma-4-31b-it": {
      "mode": "primary",
      "model": "google/gemma-4-31b-it"
    },
    "google-gemini-3.5-flash-lite": {
      "mode": "primary",
      "model": "google/gemini-3.5-flash-lite"
    },
    "google-gemini-3.8-flash": {
      "mode": "primary",
      "model": "google/gemini-3.8-flash"
    }
  },
  "providers": {
    "openrouter": {
      "env": [
        "OPENROUTER_API_KEY"
      ],
      "settings": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    },
    "google": {
      "name": "Google",
      "env": [
        "GEMINI_API_KEY"
      ],
      "package": "@opencode-ai/ai/providers/google",
      "settings": {
        "apiKey": "{env:GEMINI_API_KEY}"
      },
      "models": {
        "gemma-4-26b-a4b-it": {
          "modelID": "gemma-4-26b-a4b-it",
          "name": "Gemma 4 26B A4B IT"
        },
        "gemma-4-31b-it": {
          "modelID": "gemma-4-31b-it",
          "name": "Gemma 4 31B IT"
        },
        "gemini-3.5-flash-lite": {
          "modelID": "gemini-3.5-flash-lite",
          "name": "Gemini 3.5 Flash Lite"
        },
        "gemini-3.8-flash": {
          "modelID": "gemini-3.8-flash",
          "name": "Gemini 3.8 Flash"
        }
      }
    },
    "nous": {
      "name": "Nous Research",
      "env": [
        "NOUS_API_KEY"
      ],
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://inference-api.nousresearch.com/v1",
        "apiKey": "{env:NOUS_API_KEY}"
      },
      "models": {
        "longcat-2.0": {
          "modelID": "meituan/longcat-2.0:free",
          "name": "LongCat 2.0"
        }
      }
    },
    "nvidia": {
      "name": "NVIDIA NIM",
      "env": [
        "NVIDIA_API_KEY"
      ],
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:NVIDIA_API_KEY}",
        "setCacheKey": false
      }
    },
    "bai": {
      "name": "b.ai",
      "env": [
        "BAI_API_KEY"
      ],
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.b.ai/v1",
        "apiKey": "{env:BAI_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash": {
          "modelID": "deepseek-v4-flash",
          "name": "DeepSeek V4 Flash",
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low"
              }
            },
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high"
              }
            },
            {
              "id": "max",
              "settings": {
                "reasoningEffort": "max"
              }
            }
          ]
        },
        "deepseek-v4.1-flash": {
          "modelID": "deepseek-v4.1-flash",
          "name": "DeepSeek V4.1 Flash",
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low"
              }
            },
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high"
              }
            },
            {
              "id": "max",
              "settings": {
                "reasoningEffort": "max"
              }
            }
          ]
        }
      }
    },
    "cline": {
      "name": "Cline",
      "env": [
        "CLINE_API_KEY"
      ],
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.cline.bot/api/v1",
        "apiKey": "{env:CLINE_API_KEY}"
      },
      "models": {
        "glm-5.3-flash": {
          "modelID": "z-ai/glm-5.3-flash",
          "name": "GLM-5.3-Flash",
          "variants": [
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low"
              }
            },
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high"
              }
            },
            {
              "id": "max",
              "settings": {
                "reasoningEffort": "max"
              }
            }
          ]
        },
        "laguna-s-2.1": {
          "modelID": "poolside/laguna-s-2.1",
          "name": "Laguna S 2.1"
        },
        "minimax-m2.5": {
          "modelID": "minimax/minimax-m2.5",
          "name": "MiniMax M2.5"
        }
      }
    },
    "empero": {
      "name": "Empero",
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://free.empero.org/v1"
      }
    },
    "novita": {
      "name": "Novita",
      "env": [
        "NOVITA_API_KEY"
      ],
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://novita.helicone.ai/v3/openai",
        "apiKey": "{env:NOVITA_API_KEY}"
      }
    },
    "tokenrouter": {
      "name": "TokenRouter",
      "env": [
        "TOKENROUTER_API_KEY"
      ],
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.tokenrouter.com/v1",
        "apiKey": "{env:TOKENROUTER_API_KEY}"
      }
    },
    "agnes": {
      "name": "Agnes",
      "env": [
        "AGNES_API_KEY"
      ],
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://apihub.agnes-ai.com/v1",
        "apiKey": "{env:AGNES_API_KEY}"
      },
      "models": {
        "agnes-2.5-flash": {
          "modelID": "agnes-2.5-flash",
          "name": "Agnes 2.5 Flash"
        },
        "agnes-3.0-flash": {
          "modelID": "agnes-3.0-flash",
          "name": "Agnes 3.0 Flash"
        }
      }
    }
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "external_directory", "resource": "/tmp/opencode/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.agents/skills/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/*/.agents/skills/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.opencode/plan/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.opencode/build/**", "effect": "allow" },
    { "action": "read", "resource": "~/.config", "effect": "deny" },
    { "action": "read", "resource": "~/.local", "effect": "deny" },
    { "action": "read", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "skill", "resource": "README", "effect": "deny" },
    { "action": "edit", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "pwd", "effect": "ask" },
    { "action": "linkding_*", "resource": "*", "effect": "deny" },
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "deny" },
    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "subagent", "resource": "*-researcher", "effect": "allow" },
    { "action": "subagent", "resource": "bulk-reader", "effect": "allow" }
  ],
  "mcp": {
    "servers": {
      "linkding": {
        "type": "remote",
        "url": "https://linkding-mcp.example.workers.dev/mcp"
      }
    }
  }
}
