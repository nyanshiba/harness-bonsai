{
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "bunx",
          "-y",
          "@playwright/mcp@latest",
          "--headless",
          "--isolated",
          "--caps",
          "storage,network",
          "--browser",
          "chromium",
          "--executable-path",
          "/usr/lib64/chromium-browser/headless_shell"
        ]
      }
    }
  }
}